{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SeerSolar",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "main.cpp",
        "Client.cpp",
        "Product.cpp",
        "Sale.cpp",
        "SalesRepresentative.cpp",
        "Database.cpp",
        "-LC:/msys64/ucrt64/lib",
        "-lsqlite3",
        "-o",
        "SeerSolar.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
